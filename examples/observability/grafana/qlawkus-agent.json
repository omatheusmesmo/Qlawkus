        "displayMode": "basic",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (phase, outcome) (increase(qlawkus_redeploy_phase_duration_seconds_sum[$__range])) / sum by (phase, outcome) (increase(qlawkus_redeploy_phase_duration_seconds_count[$__range]))",
          "legendFormat": "{{phase}} {{outcome}}",
          "instant": true,
          "refId": "A"
