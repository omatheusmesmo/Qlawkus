{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Qlawkus agent",
  "uid": "qlawkus-agent",
  "description": "What the agent did: turns, memory, tools, stores, model resilience and redeploys. Versioned with the code that emits the metrics.",
  "tags": [
    "qlawkus"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Turns and the model",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Turns per minute",
      "description": "Agent turns answered, across every channel (REST, Discord, Telegram).",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(langchain4j_aiservices_counted_total[$__rate_interval])) * 60",
          "legendFormat": "turns/min",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Turn latency",
      "description": "Whole ReAct turns, tool calls included. Open the trace of a slow one to see which tool stalled.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (rate(langchain4j_aiservices_timed_seconds_sum[$__rate_interval])) / sum (rate(langchain4j_aiservices_timed_seconds_count[$__rate_interval]))",
          "legendFormat": "average",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(langchain4j_aiservices_timed_seconds_max)",
          "legendFormat": "slowest",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Model call latency",
      "description": "Single calls to the model provider. A turn makes one per ReAct step.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (rate(gen_ai_client_operation_duration_seconds_sum[$__rate_interval])) / sum (rate(gen_ai_client_operation_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "average",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(gen_ai_client_operation_duration_seconds_max)",
          "legendFormat": "slowest",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens per minute",
      "description": "Input and output tokens reported by the provider.",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(gen_ai_client_token_usage_total[$__rate_interval])) * 60",
          "legendFormat": "tokens/min",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Active memory",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Retrieval hit ratio",
      "description": "Share of turns where active memory found at least one relevant fact. A drop means recall stopped working, not that the owner stopped asking.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(qlawkus_retrieval_queries_total{outcome=\"hit\"}[$__rate_interval])) / sum(rate(qlawkus_retrieval_queries_total[$__rate_interval]))",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Facts injected per turn",
      "description": "How many facts the retriever put in the prompt.",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (rate(qlawkus_retrieval_facts_sum[$__rate_interval])) / sum (rate(qlawkus_retrieval_facts_count[$__rate_interval]))",
          "legendFormat": "average",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(qlawkus_retrieval_facts_max)",
          "legendFormat": "most",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Retrieval score",
      "description": "Cosine score of the facts that passed the min-score margin.",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (rate(qlawkus_retrieval_score_sum[$__rate_interval])) / sum (rate(qlawkus_retrieval_score_count[$__rate_interval]))",
          "legendFormat": "average",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(qlawkus_retrieval_score_max)",
          "legendFormat": "best",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Retrieval latency",
      "description": "Time active memory adds before every reply.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (rate(qlawkus_retrieval_duration_seconds_sum[$__rate_interval])) / sum (rate(qlawkus_retrieval_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "average",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(qlawkus_retrieval_duration_seconds_max)",
          "legendFormat": "slowest",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Tools",
      "id": 11,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tool calls by outcome",
      "description": "Extension tool calls per second, per tool. A failure series names the tool that broke.",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tool, outcome) (rate(qlawkus_tool_invocations_total[$__rate_interval]))",
          "legendFormat": "{{tool}} {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tool latency",
      "description": "Average and slowest call per tool.",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (tool) (rate(qlawkus_tool_duration_seconds_sum[$__rate_interval])) / sum by (tool) (rate(qlawkus_tool_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{tool}} average",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (tool) (qlawkus_tool_duration_seconds_max)",
          "legendFormat": "{{tool}} slowest",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Stores",
      "id": 14,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Store operations",
      "description": "Calls into the cognition stores, per store and backend. Readiness polls appear here as operation=verifyWritable.",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (store, backend, outcome) (rate(qlawkus_store_operations_total[$__rate_interval]))",
          "legendFormat": "{{store}} {{backend}} {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Store latency",
      "description": "What the markdown, pgvector and hybrid switch costs, per store and operation.",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (store, operation) (rate(qlawkus_store_duration_seconds_sum[$__rate_interval])) / sum by (store, operation) (rate(qlawkus_store_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{store}} {{operation}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (store) (qlawkus_store_duration_seconds_max)",
          "legendFormat": "{{store}} slowest",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Embedding",
      "id": 17,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Facts embedded",
      "description": "Facts sent to the embedding model, by outcome.",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 53
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (rate(qlawkus_embedding_facts_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Segments per fact",
      "description": "Facts over the chunk budget are split before embedding; oversized counts them.",
      "id": 19,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 53
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum (rate(qlawkus_embedding_segments_sum[$__rate_interval])) / sum (rate(qlawkus_embedding_segments_count[$__rate_interval]))",
          "legendFormat": "segments per fact",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(qlawkus_embedding_oversized_total[$__rate_interval]))",
          "legendFormat": "oversized facts/s",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Background jobs",
      "id": 20,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 61
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Job duration",
      "description": "Memory review and curation, episodic consolidation, skill curation and lifecycle.",
      "id": 21,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 62
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job) (rate(qlawkus_job_duration_seconds_sum[$__rate_interval])) / sum by (job) (rate(qlawkus_job_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{job}} average",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (job) (qlawkus_job_duration_seconds_max)",
          "legendFormat": "{{job}} slowest",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Items per run",
      "description": "What each job run worked through.",
      "id": 22,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 62
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job) (rate(qlawkus_job_items_sum[$__rate_interval])) / sum by (job) (rate(qlawkus_job_items_count[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Model resilience",
      "id": 23,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 70
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Circuit breakers",
      "description": "0 closed, 1 half-open, 2 open, per surface and workload. Readiness only follows the interactive workload.",
      "id": 24,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 71
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 2,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "closed",
                  "color": "green"
                },
                "1": {
                  "text": "half-open",
                  "color": "yellow"
                },
                "2": {
                  "text": "open",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (surface, workload) (qlawkus_model_circuit_state)",
          "legendFormat": "{{surface}} {{workload}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fallbacks to the secondary model",
      "description": "Calls answered by the fallback provider. Counted even when the breaker never opens.",
      "id": 25,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 71
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
