####
# Self-contained NATIVE image: builds the GraalVM native binary in-container, so
# building needs only Docker (no host toolchain). Build context is the repo ROOT.
#
# Multi-stage build following the Quarkus Mandrel pattern
# (https://quarkus.io/guides/building-native-image#multistage-docker). Uses its
# own Dockerfile.native-build.dockerignore so the standard .dockerignore stays
# untouched.
#
# Heavy: the native compile takes several minutes and a few GB of RAM.
# Build + run via: ./run.sh native
#
# QLAWKUS_COMPOSITION is 'full' (default) or 'image': see Dockerfile.jvm-build.
####

ARG QLAWKUS_COMPOSITION=full

# --- Build stage: Mandrel builder, native reactor build ----------------------
# The Mandrel builder ships no Maven but has curl+unzip, so the mvnw wrapper works.
# The reactor is installed in full: a partial -pl app -am build skips the *-deployment
# modules the extension-descriptor check needs from a fresh local repo.
FROM quay.io/quarkus/ubi10-quarkus-mandrel-builder-image:jdk-25.0.6_3 AS build
USER root
WORKDIR /code
ARG QLAWKUS_COMPOSITION
COPY . .
RUN --mount=type=cache,target=/root/.m2 \
    if [ "${QLAWKUS_COMPOSITION}" = "image" ]; then \
      cp app/src/main/docker/agent-image.yml app/src/main/resources/qlawkus/agent.yml \
      && ./mvnw -B -e -DskipTests -DskipITs -pl composition-maven-plugin -am install \
      && ./mvnw -B -e qlawkus:generate -pl app -am; \
    elif [ "${QLAWKUS_COMPOSITION}" != "full" ]; then \
      echo "QLAWKUS_COMPOSITION must be image or full, got ${QLAWKUS_COMPOSITION}" >&2; exit 1; \
    fi
# The native profile turns quarkus.native.enabled on for every packaging=quarkus module, so running
# it over the reactor compiled a native executable for each integration test module and the docs
# site (18 native-image runs, about 80 minutes). The reactor is installed as plain jars first, and
# only the app is then compiled to native, against those installed artifacts.
RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw -B -e -DskipTests -DskipITs install
RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw -B -e -DskipTests -DskipITs -Pnative -pl app package

# The attachments capability brings Quarkus AWT. Copy its native support files
# when the build emits them.
RUN set -eu; \
    mkdir /native-app; \
    cp /code/app/target/*-runner /native-app/application; \
    chmod 0755 /native-app/application; \
    for file in /code/app/target/*.so /code/app/target/quarkus-artifact.properties; do \
        if [ -f "$file" ]; then cp "$file" /native-app/; fi; \
    done

# --- Runtime stage: Quarkus native runtime with headless PDF and PTY support ---
FROM registry.access.redhat.com/ubi10/ubi-minimal:10.3
RUN microdnf install -y --nodocs --setopt=install_weak_deps=0 freetype fontconfig util-linux && microdnf clean all
WORKDIR /work/
ENV HOME=/home/default
ENV QLAWKUS_WORKSPACE_ROOT=/home/default/workspace
RUN mkdir -p /home/default \
    && chown 185:0 /home/default /work \
    && chmod g+rwX /home/default /work
COPY --from=build --chown=185:0 /native-app/ /work/

EXPOSE 8080
USER 185

# A native image takes user.home from the passwd entry, not from HOME, and the base has none for uid 185
# (or for any uid the container is started with), so it resolved to "?" and ~/.qlawkus (keystore, state,
# facts) landed in /work/?, outside the volume at /home/default. The JVM falls back to HOME, so only this
# image needs user.home set from it at start, which keeps it right for whatever uid and HOME it runs with.
ENTRYPOINT ["sh", "-c", "exec ./application -Dquarkus.http.host=0.0.0.0 -Duser.home=\"${HOME}\" \"$@\"", "sh"]
