####
# This Dockerfile is used in order to build a container that runs the Quarkus application in native (no JVM) mode.
# It uses UBI minimal with the font libraries required by native PDF extraction.
# Check https://quarkus.io/guides/quarkus-runtime-base-image for further information about this image.
#
# Before building the container image run:
#
# ./mvnw package -Dnative
#
# Then, build the image with:
#
# docker build -f src/main/docker/Dockerfile.native-micro -t quarkus/qlawkus-app .
#
# Then run the container using:
#
# docker run -i --rm -p 8080:8080 quarkus/qlawkus-app
#
###
FROM registry.access.redhat.com/ubi10/ubi-minimal:10.3
RUN microdnf install -y --nodocs --setopt=install_weak_deps=0 freetype fontconfig util-linux && microdnf clean all
WORKDIR /work/
RUN --mount=type=bind,source=target,target=/target \
    set -eu; \
    cp /target/*-runner /work/application; \
    chmod 0755 /work/application; \
    for file in /target/*.so /target/quarkus-artifact.properties; do \
        if [ -f "$file" ]; then cp "$file" /work/; fi; \
    done; \
    chown -R 1001:root /work; \
    chmod g+rwX /work

EXPOSE 8080
USER 1001

ENTRYPOINT ["./application", "-Dquarkus.http.host=0.0.0.0"]
